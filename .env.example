# ==============================================================================
# ClosePilot / Vexa Environment Configuration
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# ==============================================================================

# Application & Server
VEXA_APP_NAME="ClosePilot Backend"
VEXA_ENVIRONMENT="development"
VEXA_DEBUG=false
VEXA_API_PREFIX="/api"

# Database Connection
VEXA_DB_URL="postgresql+asyncpg://localhost:5432/vexa"
VEXA_DB_ECHO=false
VEXA_DB_POOL_SIZE=10
VEXA_DB_MAX_OVERFLOW=20

# ==============================================================================
# Multi-Provider LLM Credentials
# ==============================================================================

# Investigation Agent (Primary: Mistral AI)
VEXA_MISTRAL_API_KEY=your_mistral_api_key_here
VEXA_MISTRAL_MODEL=codestral-latest
VEXA_MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Verification Agent (Primary: Groq)
VEXA_GROQ_API_KEY=your_groq_api_key_here
VEXA_GROQ_MODEL=qwen/qwen3.8-27b
VEXA_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Close Controller (Primary: Google Gemini)
VEXA_GEMINI_API_KEY=your_gemini_api_key_here
VEXA_GEMINI_MODEL=gemini-3.5-flash-lite
VEXA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Legacy / Generic LLM Provider (Optional Fallback)
VEXA_LLM_PROVIDER=deterministic
VEXA_LLM_TIMEOUT_SECONDS=30.0

# Circuit Breakers
VEXA_INVESTIGATION_MAX_STEPS=15
VEXA_INVESTIGATION_MAX_SECONDS=30.0

# Seed Determinism
VEXA_SEED_DETERMINISTIC=true
VEXA_SEED_RANDOM_SEED=42
